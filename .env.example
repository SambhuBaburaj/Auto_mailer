# Copy this file to .env and fill in your real SMTP details.
#
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

MAIL_FROM_NAME=Sambhu Baburaj
MAIL_FROM_EMAIL=your-email@gmail.com

RESUME_PATH=/Users/sambhu/Downloads/Sambhu Baburaj .pdf
DEFAULT_SUBJECT=Application for Frontend Developer Position

# Delay between each email. Keep this non-zero to avoid sending too fast.
SEND_DELAY_MS=1500
